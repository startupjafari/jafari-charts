{
  "name": "jafari-charts",
  "version": "0.1.0",
  "private": true,
  "description": "Jafari Charts — engineered for performance. Beautiful charts. Zero compromise.",
  "author": "Mehman Jafari",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "build:apps": "pnpm -r --filter './apps/*' run build",
    "dev:docs": "pnpm --filter @startupjafari/charts-docs dev",
    "dev:playground": "pnpm --filter @startupjafari/charts-playground dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project desktop --project mobile",
    "size": "node scripts/size.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "bench": "node benchmarks/run.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size && pnpm pack:check",
    "release:check": "pnpm clean && pnpm format:check && pnpm check",
    "clean": "pnpm -r exec rm -rf dist .turbo && rm -rf coverage test-results playwright-report",
    "test:visual": "scripts/e2e-docker.sh --project desktop --grep @visual",
    "test:visual:update": "scripts/e2e-docker.sh --project desktop --grep @visual --update-snapshots",
    "storybook": "pnpm --filter @startupjafari/charts-storybook storybook",
    "bench:core": "node benchmarks/core.mjs",
    "bench:leak": "node benchmarks/leak.mjs",
    "test:e2e:all": "scripts/e2e-docker.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
