{
  "name": "@jafari/charts-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Component workbench: every chart in its states (default, empty, loading, error, dark, many series).",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static --quiet",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jafari/charts": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.9",
    "storybook": "^10.6.9"
  }
}
