{
  "name": "@jafari/charts",
  "version": "0.1.0",
  "author": "Mehman Jafari",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "charts",
    "data-visualization",
    "svg",
    "canvas",
    "react",
    "typescript"
  ],
  "description": "Jafari Charts — engineered for performance. Beautiful charts. Zero compromise.",
  "exports": {
    ".": {
      "@jafari/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "@jafari/source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./themes": {
      "@jafari/source": "./src/themes.ts",
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js",
      "default": "./dist/themes.js"
    },
    "./export": {
      "@jafari/source": "./src/export.ts",
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js",
      "default": "./dist/export.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('../themes/dist/styles.css','dist/styles.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js",
        "default": "./dist/core.js"
      },
      "./themes": {
        "types": "./dist/themes.d.ts",
        "import": "./dist/themes.js",
        "default": "./dist/themes.js"
      },
      "./export": {
        "types": "./dist/export.d.ts",
        "import": "./dist/export.js",
        "default": "./dist/export.js"
      },
      "./package.json": "./package.json",
      "./styles.css": "./dist/styles.css"
    }
  },
  "dependencies": {
    "@jafari/charts-core": "workspace:*",
    "@jafari/charts-themes": "workspace:*",
    "@jafari/charts-react": "workspace:*",
    "@jafari/charts-export": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  }
}
