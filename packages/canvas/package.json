{
  "name": "@jafari/charts-canvas",
  "version": "0.1.0",
  "author": "Mehman Jafari",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "charts",
    "data-visualization",
    "svg",
    "canvas",
    "react",
    "typescript"
  ],
  "description": "Canvas 2D renderer for Jafari Charts scenes (HiDPI, layered, hit-testable).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startupjafari/jafari-charts.git",
    "directory": "packages/canvas"
  },
  "homepage": "https://github.com/startupjafari/jafari-charts#readme",
  "bugs": {
    "url": "https://github.com/startupjafari/jafari-charts/issues"
  },
  "exports": {
    ".": {
      "@jafari/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "dependencies": {
    "@jafari/charts-core": "workspace:*"
  }
}
